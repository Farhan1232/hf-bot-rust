# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The bot reads these at runtime. Keys are NOT compiled into the binary,
# so you can rotate them anytime by editing .env — no rebuild needed.

# --- Binance API keys ---
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# LIVE TRADING (real money) = both of the next two lines set to false.
# This is the normal setting. Set USE_DEMO=true only to practise with fake money.
# The bot prints which mode it is in on every start-up — always check that line.
USE_DEMO=false
# TESTNET=true overrides USE_DEMO and uses Binance Futures Testnet, which gives
# FREE API keys with NO ID/KYC (log in with GitHub/Google at
# https://testnet.binancefuture.com). Great for testing. Set false for demo/live.
TESTNET=false
API_TIMEOUT=30

# --- Entry mode (replaces the old start-up menu, so it works as a 24/7 service) ---
# auto   = watch/confirm percentage entry (option 2 in the old menu)
# custom = open only when the price reaches a level you choose (option 1)
#
# To switch to custom: set ENTRY_MODE=custom AND fill in BOTH prices below,
# then restart. The bot will then ignore the watch/confirm percentages
# completely and enter ONLY at these two prices.
#
#   CUSTOM_ENTRY_HIGH -> price rises to this  -> opens LONG   (put it ABOVE the current price)
#   CUSTOM_ENTRY_LOW  -> price falls to this  -> opens SHORT  (put it BELOW the current price)
#
# Example, if the coin is trading at 0.2500 right now:
#   ENTRY_MODE=custom
#   CUSTOM_ENTRY_LOW=0.2400     <- 4% below -> SHORT
#   CUSTOM_ENTRY_HIGH=0.2600    <- 4% above -> LONG
#
# Careful: if you set LOW ABOVE the current price (or HIGH BELOW it), that side
# is already reached and the bot opens immediately on start-up.
#
# Whichever level is hit first wins. After the trade closes the bot re-arms and
# waits for these same two prices again.
ENTRY_MODE=auto
CUSTOM_ENTRY_LOW=
CUSTOM_ENTRY_HIGH=

# --- Trading settings (this is where you set coin / leverage / SL / TP) ---
SYMBOL=XRPUSDT
LEVERAGE=2
POSITION_SIZE=10
TAKE_PROFIT_PERCENTAGE=2.0
STOP_LOSS_PERCENTAGE=0.25
WATCH_PERCENTAGE=0.05
CONFIRM_PERCENTAGE=0.10
PRICE_CHECK_INTERVAL=0.1
