# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The bot reads these at runtime. Keys are NOT compiled into the binary,
# so you can rotate them anytime by editing .env — no rebuild needed.

# --- Binance API (demo keys from https://demo.binance.com) ---
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# true = demo (no real money) | false = live trading
USE_DEMO=true
# TESTNET=true overrides USE_DEMO and uses Binance Futures Testnet, which gives
# FREE API keys with NO ID/KYC (log in with GitHub/Google at
# https://testnet.binancefuture.com). Great for testing. Set false for demo/live.
TESTNET=false
API_TIMEOUT=30

# --- Entry mode (replaces the old start-up menu, so it works as a 24/7 service) ---
# auto   = watch/confirm percentage entry (option 2 in the old menu)
# custom = enter on a price range (option 1). Requires the two prices below.
ENTRY_MODE=auto
CUSTOM_ENTRY_LOW=
CUSTOM_ENTRY_HIGH=

# --- Trading settings (this is where you set coin / leverage / SL / TP) ---
SYMBOL=XRPUSDT
LEVERAGE=15
POSITION_SIZE=10
TAKE_PROFIT_PERCENTAGE=2.0
STOP_LOSS_PERCENTAGE=0.05
WATCH_PERCENTAGE=0.05
CONFIRM_PERCENTAGE=0.10
PRICE_CHECK_INTERVAL=0.1
